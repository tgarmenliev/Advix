DATABASE_URL="postgresql://user:password@host:5432/advix?schema=public"
JWT_ACCESS_SECRET="change-me-min-32-chars-in-production"
JWT_REFRESH_SECRET="change-me-different-min-32-chars"
SCW_ACCESS_KEY="change-me"
SCW_SECRET_KEY="change-me"
SCW_BUCKET_NAME="advix-documents"
SCW_REGION="fr-par"
SCW_ENDPOINT="https://s3.fr-par.scw.cloud"
EMAIL_PROVIDER="resend"
EMAIL_API_KEY="change-me"
EMAIL_FROM="noreply@advix.bg"
# Безопасен режим: не праща реални имейли (само логва). Сложи "false" само с
# реален ключ, за да пращаш истински писма.
EMAIL_DRY_RUN="true"
NODE_ENV="development"
PORT=3000
# Базов URL за Secure Link адресите в имейлите (без крайно "/")
APP_BASE_URL="http://localhost:3000"
